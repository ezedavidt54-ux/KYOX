generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AgentMode {
  OBSERVE
  SHADOW
  PAPER
  AUTONOMOUS
  PAUSED
}

enum TradeSource {
  MANUAL
  IMPORTED
  AGENT
}

enum DecisionAction {
  BUY
  SELL
  HOLD
  WAIT
  REJECT
}

enum DecisionStatus {
  PROPOSED
  APPROVED
  REJECTED
  EXECUTED
  EXPIRED
}

model User {
  id             String           @id @default(cuid())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  displayName    String?
  wallets        Wallet[]
  tradingProfile TradingProfile?
  agents         TradingAgent[]
  trades         Trade[]
  decisions      TradeDecision[]
  observations   AgentObservation[]
  feedback       AgentFeedback[]
}

model Wallet {
  id         String   @id @default(cuid())
  address    String
  chainId    Int
  label      String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([address, chainId])
  @@index([userId])
}

model TradingProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  markets             String[] @default([])
  timeframes          String[] @default([])
  biasMethod          String?
  entryMethod         String?
  riskRules           Json?
  managementRules     Json?
  invalidationRules   Json?
  newsRules           Json?
  notes               String?
  version             Int      @default(1)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model TradingAgent {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  mode              AgentMode @default(OBSERVE)
  enabled           Boolean   @default(false)
  systemVersion     String    @default("foundation-1")
  confidenceFloor   Float     @default(0.70)
  maxRiskPerTrade   Float     @default(0.005)
  maxDailyLoss      Float     @default(0.02)
  allowedAssets     String[]  @default([])
  allowedProtocols  String[]  @default([])
  memorySummary     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  decisions         TradeDecision[]
  observations     AgentObservation[]
  feedback          AgentFeedback[]

  @@index([userId])
}

model Trade {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId         String?
  agent            TradingAgent? @relation(fields: [agentId], references: [id], onDelete: SetNull)
  source          TradeSource
  chainId         Int
  asset           String
  side            String
  entryPrice      Float?
  exitPrice       Float?
  quantity        Float?
  stopLoss        Float?
  takeProfit      Float?
  riskAmount      Float?
  pnl             Float?
  openedAt        DateTime?
  closedAt        DateTime?
  metadata        Json?
  createdAt       DateTime    @default(now())

  @@index([userId, createdAt])
  @@index([agentId, createdAt])
}

model TradeDecision {
  id             String         @id @default(cuid())
  userId         String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId        String
  agent          TradingAgent   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  action         DecisionAction
  status         DecisionStatus @default(PROPOSED)
  asset          String
  thesis         String?
  confidence     Float?
  proposedEntry  Float?
  proposedStop   Float?
  proposedTarget Float?
  proposedRisk   Float?
  marketSnapshot Json?
  reasoning      Json?
  decidedAt      DateTime       @default(now())
  expiresAt      DateTime?

  @@index([agentId, decidedAt])
  @@index([userId, decidedAt])
}

model AgentObservation {
  id             String       @id @default(cuid())
  userId         String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId        String
  agent          TradingAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  asset          String
  timeframe      String?
  marketSnapshot Json
  detectedSetup  Json?
  expectedAction DecisionAction?
  actualAction   DecisionAction?
  observedAt     DateTime     @default(now())

  @@index([agentId, observedAt])
}

model AgentFeedback {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId    String
  agent      TradingAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  decisionId String?
  rating     Int?
  correction String?
  metadata   Json?
  createdAt  DateTime     @default(now())

  @@index([agentId, createdAt])
}
